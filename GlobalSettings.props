<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <PEPRepoRoot Condition="'$(PEPRepoRoot)'==''">$(MSBuildThisFileDirectory)</PEPRepoRoot>
    <PEPEnableAssetDebugLogs Condition="'$(PEPEnableAssetDebugLogs)'==''">0</PEPEnableAssetDebugLogs>
    <OutDir>$(PEPRepoRoot)Build\bin\$(PlatformName)\$(Configuration)\$(ProjectName)\</OutDir>
    <IntDir>$(PEPRepoRoot)Build\obj\$(PlatformName)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(PEPEnableProfiling)'=='true'">
    <ClCompile><PreprocessorDefinitions>PROFILE_BUILD;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>
          PEP_ENABLE_ASSET_DEBUG_LOGS=$(PEPEnableAssetDebugLogs);
          SOLUTION_DIR=LR"($(PEPRepoRoot))";
          PROJECT_DIR=LR"($(ProjectDir))";
          ASSETS_FOLDER=LR"($(PEPRepoRoot)Assets\\)";
          TEXTURES_FOLDER=LR"($(PEPRepoRoot)Assets\Textures\\)";
          MODELS_FOLDER=LR"($(PEPRepoRoot)Assets\Models\\)";
          SHADERS_FOLDER=LR"($(PEPRepoRoot)Engine\Engine.RendererDX12\Shaders\\)";
          %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup />
  <Target Name="CopyEngineConfiguration" AfterTargets="Build" Condition="'$(ConfigurationType)' == 'Application'">
    <MakeDir Directories="$(TargetDir)Config" />
    <Copy SourceFiles="$(PEPRepoRoot)Config\Engine.ini" DestinationFiles="$(TargetDir)Config\Engine.ini"
          Condition="!Exists('$(TargetDir)Config\Engine.ini')" />
  </Target>
</Project>
