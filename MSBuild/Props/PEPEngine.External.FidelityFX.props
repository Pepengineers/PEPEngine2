<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PEPFidelityFXRoot>$(PEPRepoRoot)Build\FidelityFXSource\sdk\</PEPFidelityFXRoot>
    <PEPFidelityFXSuffix Condition="'$(Configuration)' == 'Debug'">d</PEPFidelityFXSuffix>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(PEPFidelityFXRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(PEPFidelityFXRoot)bin\ffx_sdk\ffx_sssr_x64$(PEPFidelityFXSuffix).lib;$(PEPFidelityFXRoot)bin\ffx_sdk\ffx_dof_x64$(PEPFidelityFXSuffix).lib;$(PEPFidelityFXRoot)bin\ffx_sdk\ffx_denoiser_x64$(PEPFidelityFXSuffix).lib;$(PEPFidelityFXRoot)bin\ffx_sdk\ffx_backend_dx12_x64$(PEPFidelityFXSuffix).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="BuildFidelityFX" BeforeTargets="ClCompile" Condition="'$(MSBuildProjectName)' == 'Engine.RendererDX12'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(PEPRepoRoot)MSBuild\BuildFidelityFX.ps1&quot; -Configuration &quot;$(Configuration)&quot; -CMake &quot;$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe&quot;" />
  </Target>
</Project>
