<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PEPFidelityFXImported>true</PEPFidelityFXImported>
    <PEPFidelityFX>$(PEPRepoRoot)Build\dependencies\FidelityFX-SDK-c6efa6bf7f2027b3ec94f28578bb5965eabb9e55\sdk\</PEPFidelityFX>
    <PEPFidelityFXPostfix Condition="'$(Configuration)'=='Debug'">d</PEPFidelityFXPostfix>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(PEPFidelityFX)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(PEPFidelityFX)bin\ffx_sdk;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ffx_dof_x64$(PEPFidelityFXPostfix).lib;ffx_backend_dx12_x64$(PEPFidelityFXPostfix).lib;dxgi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="PrepareFidelityFX" BeforeTargets="ClCompile" Condition="'$(ProjectName)'=='Engine.RendererDX12' and '$(Platform)'=='x64'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(PEPRepoRoot)External\PrepareFidelityFX.ps1&quot; -Configuration $(Configuration)" />
  </Target>
</Project>
