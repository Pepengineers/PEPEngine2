<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PEPFidelityFXRoot>$(PEPRepoRoot)Build\Dependencies\FidelityFX-SDK-c6efa6bf7f2027b3ec94f28578bb5965eabb9e55\sdk\</PEPFidelityFXRoot>
    <PEPFidelityFXPostfix Condition="'$(Configuration)'=='Debug'">d</PEPFidelityFXPostfix>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(PEPFidelityFXRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(PEPFidelityFXRoot)bin\ffx_sdk;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ffx_sssr_x64$(PEPFidelityFXPostfix).lib;ffx_denoiser_x64$(PEPFidelityFXPostfix).lib;ffx_backend_dx12_x64$(PEPFidelityFXPostfix).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
