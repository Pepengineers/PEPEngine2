<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)PEPEngine.Module.Engine.UI.Public.props" Condition="Exists('$(MSBuildThisFileDirectory)PEPEngine.Module.Engine.UI.Public.props')" />
  <Import Project="$(MSBuildThisFileDirectory)PEPEngine.External.Jolt.props" Condition="Exists('$(MSBuildThisFileDirectory)PEPEngine.External.Jolt.props')" />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(PEPRepoRoot)Apps\App.Base\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="CopyCollisionBakingLicenses" AfterTargets="Build" Condition="'$(ConfigurationType)'=='Application'">
    <Copy SourceFiles="$(PEPRepoRoot)External\External.Libraries\meshoptimizer\LICENSE.md" DestinationFiles="$(TargetDir)Licenses\meshoptimizer\LICENSE.md" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PEPRepoRoot)External\External.Libraries\vhacd\LICENSE" DestinationFiles="$(TargetDir)Licenses\vhacd\LICENSE" SkipUnchangedFiles="true" />
  </Target>
</Project>
