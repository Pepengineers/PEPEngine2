# Physics sandbox. Set App.StartScene to Scenes/PhysicsSandbox.yaml.
# Centered at x=50 to avoid the legacy backend test at x=0.
# Visible motion requires the physics-to-ECS transform synchronization.
World:
  Name: PhysicsSandboxWorld

  Systems:
    - Name: DynamicBodyUpdateSystem
      Priority: 0
    - Name: GPUDataUpdateSystem
      Priority: 101
    - Name: RenderSubmitSystem
      Priority: 102

  Resources:
    Meshes:
      - Id: SandboxCubeMesh
        Source: Assets/Models/PhysicsSandbox/UnitCube.obj
        SubmitToRenderer: true
        ImportMaterials: true
      - Id: SandboxFloorMesh
        Source: Assets/Models/PhysicsSandbox/FloorCube.obj
        SubmitToRenderer: true
        ImportMaterials: true

  Entities:
    - Id: Floor
      Components:
        Name:
          Value: Floor
        Transform:
          Location: [50, -0.5, 0.0]
          Rotation: [0.0, 0.0, 0.0]
          Scale: [24, 1, 20]
        RigidBody:
          MotionType: Static
        BoxCollider:
          HalfExtent: [0.5, 0.5, 0.5]
        StaticMeshRender:
          Mesh: SandboxFloorMesh

    - Id: CubeResting
      Components:
        Name:
          Value: CubeResting
        Transform:
          Location: [45, 1, -3]
          Rotation: [0.0, 0.0, 0.0]
          Scale: [2, 2, 2]
        RigidBody:
          MotionType: Dynamic
        BoxCollider:
          HalfExtent: [0.5, 0.5, 0.5]
        StaticMeshRender:
          Mesh: SandboxCubeMesh

    - Id: CubeDrop
      Components:
        Name:
          Value: CubeDrop
        Transform:
          Location: [49, 7, -3]
          Rotation: [0.0, 0.0, 0.0]
          Scale: [2, 2, 2]
        RigidBody:
          MotionType: Dynamic
        BoxCollider:
          HalfExtent: [0.5, 0.5, 0.5]
        StaticMeshRender:
          Mesh: SandboxCubeMesh

    - Id: CubeTilted
      Components:
        Name:
          Value: CubeTilted
        Transform:
          Location: [53, 5, -2]
          Rotation: [12, 25, 8]
          Scale: [2, 2, 2]
        RigidBody:
          MotionType: Dynamic
        BoxCollider:
          HalfExtent: [0.5, 0.5, 0.5]
        StaticMeshRender:
          Mesh: SandboxCubeMesh

    - Id: CubeLarge
      Components:
        Name:
          Value: CubeLarge
        Transform:
          Location: [55, 9, 3]
          Rotation: [0.0, 15, 0.0]
          Scale: [3, 3, 3]
        RigidBody:
          MotionType: Dynamic
        BoxCollider:
          HalfExtent: [0.5, 0.5, 0.5]
        StaticMeshRender:
          Mesh: SandboxCubeMesh

    - Id: CubeStackLower
      Components:
        Name:
          Value: CubeStackLower
        Transform:
          Location: [47, 1, 3]
          Rotation: [0.0, 0.0, 0.0]
          Scale: [2, 2, 2]
        RigidBody:
          MotionType: Dynamic
        BoxCollider:
          HalfExtent: [0.5, 0.5, 0.5]
        StaticMeshRender:
          Mesh: SandboxCubeMesh

    - Id: CubeStackUpper
      Components:
        Name:
          Value: CubeStackUpper
        Transform:
          Location: [47, 3.15, 3]
          Rotation: [0.0, 8, 0.0]
          Scale: [2, 2, 2]
        RigidBody:
          MotionType: Dynamic
        BoxCollider:
          HalfExtent: [0.5, 0.5, 0.5]
        StaticMeshRender:
          Mesh: SandboxCubeMesh

    - Id: MainCamera
      Components:
        Name:
          Value: MainCamera
        Transform:
          Location: [68, 16, -26]
          Rotation: [22.347372, -34.695154, 0.0]
          Scale: [1, 1, 1]
        Camera:
          FOV: 60.0
          NearPlane: 0.1
          FarPlane: 300.0

  ActiveCamera: MainCamera
