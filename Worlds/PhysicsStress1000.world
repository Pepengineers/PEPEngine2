# Physics stress test: 1000 dynamic cubes, 16 static obstacles and 6 kinematic cubes.
# Cascade: steep ramp -> corner-up bumpers -> opposite ramp -> repeat -> catch floor.
# Cubes start in a separated 10 x 10 x 10 grid; all meshes share two resources.
# 1022 scene bodies / 1024 body capacity.
# Six floor lanes traverse a two-point closed spline: 3 seconds each way.
# Set backend MaxBodyPairs and MaxContactConstraints to 16384 for this workload.
# A 12-second headless Jolt run overflowed the current 1024 caches; 16384 passed.
World:
  Name: PhysicsStress1000World

  Systems:
    - Name: PhysicsSystem
      Priority: 0
    - Name: FixedSplineFollowSystem
      Priority: 10
    - Name: KinematicBodySystem
      Priority: 100
    - Name: GPUDataUpdateSystem
      Priority: 101
    - Name: RenderSubmitSystem
      Priority: 102

  Resources:
    Meshes:
      - Id: StressCubeMesh
        Source: Assets/Models/PhysicsSandbox/UnitCube.obj
        SubmitToRenderer: true
        ImportMaterials: true
      - Id: StressObstacleMesh
        Source: Assets/Models/PhysicsSandbox/FloorCube.obj
        SubmitToRenderer: true
        ImportMaterials: true

  Entities:
    - Id: CatchFloor
      Components:
        Name:
          Value: CatchFloor
        Transform:
          Location: [108, -44, 0]
          Rotation: [0, 0, 0]
          Scale: [92, 3, 80]
        RigidBody:
          MotionType: Static
        BoxCollider:
          HalfExtent: [0.5, 0.5, 0.5]
        StaticMeshRender:
          Mesh: StressObstacleMesh

    - Id: RampUpper
      Components:
        Name:
          Value: RampUpper
        Transform:
          Location: [100, 72, 0]
          Rotation: [0, 0, -52]
          Scale: [28, 2.2, 26]
        RigidBody:
          MotionType: Static
        BoxCollider:
          HalfExtent: [0.5, 0.5, 0.5]
        StaticMeshRender:
          Mesh: StressObstacleMesh

    - Id: RampMiddle
