    # Lane centers split CatchFloor's 80-unit width into six equal strips.
    # Zero tangents ease to rest at each end before reversing direction.
    - Id: FloorKinematicPath01
      Components:
        SplineCurve:
          Loop: true
          Points:
            - Position: [66, -39.5, -33.333333]
              ArriveTangent: [0, 0, 0]
              LeaveTangent: [0, 0, 0]
            - Position: [150, -39.5, -33.333333]
              ArriveTangent: [0, 0, 0]
              LeaveTangent: [0, 0, 0]

    - Id: FloorKinematicCube01
      Components:
        Name:
          Value: FloorKinematicCube01
        Transform:
          Location: [66, -39.5, -33.333333]
          Rotation: [0, 0, 0]
          Scale: [6, 6, 6]
        RigidBody:
          MotionType: Kinematic
        BoxCollider:
          HalfExtent: [0.5, 0.5, 0.5]
        StaticMeshRender:
          Mesh: StressCubeMesh
        SplineFollow:
          Curve: FloorKinematicPath01
          Duration: 6.0
          Loop: true
          Playing: true
          Time: 0.0
          UpdateMode: Fixed

