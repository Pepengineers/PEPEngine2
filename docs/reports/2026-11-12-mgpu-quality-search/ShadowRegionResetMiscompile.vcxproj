    <ShadowReproOptimization Condition="'$(ShadowReproOptimization)'==''">MaxSpeed</ShadowReproOptimization>
    <OutDir>$(MSBuildThisFileDirectory)ShadowRegionResetMiscompile\$(ShadowReproOptimization)\</OutDir>
    <IntDir>$(OutDir)obj\</IntDir>
